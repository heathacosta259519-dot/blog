---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { entriesOf } from '../../lib/content';

const entries = await entriesOf('note');
---

<BaseLayout
  title="笔记"
  description="编程与系统的学习笔记：Python、Go、C#、Linux，以及踩过的坑。"
>
  <div class="shell">
    <header class="page-head">
      <h1>笔记</h1>
      <p>啃完一章或撞上一个坑之后整理的速查与解释。按时间倒序{entries.length > 0 && `，共 ${entries.length} 篇`}。</p>
    </header>
    <div class="rule"></div>
    <EntryList entries={entries} />
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-bottom: 1.6rem;
  }

  .rule {
    margin-bottom: 0.4rem;
  }
</style>
