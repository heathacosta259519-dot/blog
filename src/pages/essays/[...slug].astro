---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { readingTime } from '../../lib/content';
import { url } from '../../consts';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const minutes = readingTime(essay.body);
---

<EntryLayout
  entry={{
    title: essay.data.title,
    description: essay.data.description,
    date: essay.data.date,
    updated: essay.data.updated,
    kind: 'essay',
    tags: essay.data.tags,
    href: url(`/essays/${essay.id}/`),
    id: essay.id,
  }}
  minutes={minutes}
>
  <Content />
</EntryLayout>
