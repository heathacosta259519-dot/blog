---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../consts';
---

<BaseLayout title="找不到页面" description="这个地址没有内容。" noindex>
  <div class="shell">
    <div class="notfound">
      <p class="code">404</p>
      <h1>这一页不存在</h1>
      <p class="hint">地址可能改过，或者从来没写过。下面几个入口应该还在。</p>
      <p class="links">
        <a href={url('/')}>首页</a>
        <a href={url('/notes/')}>笔记</a>
        <a href={url('/tags/')}>标签</a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(4rem, 14vw, 8rem) 4rem;
    max-width: 34rem;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12vw, 6rem);
    line-height: 1;
    color: var(--rule);
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  h1 {
    font-size: clamp(1.4rem, 3.4vw, 1.9rem);
    margin-top: 0.6rem;
  }

  .hint {
    color: var(--ink-mute);
    font-size: 0.9375rem;
    margin-top: 0.9rem;
  }

  .links {
    display: flex;
    gap: 1.6rem;
    margin-top: 1.8rem;
    font-size: 0.9375rem;
  }

  .links a {
    color: var(--accent);
    border-bottom: 1px solid var(--rule-soft);
  }

  .links a:hover {
    border-bottom-color: var(--accent);
  }
</style>
